/* cart.wxss —— 购物车 */
.pad {
  padding: 12px;
}
.item-card {
  padding: 12px;
  margin-bottom: 10px;
}
.check {
  font-size: 18px;
  color: var(--brand);
  flex-shrink: 0;
}
.thumb {
  width: 64px;
  height: 64px;
  border-radius: 10px;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.item-name {
  font-size: 13px;
  font-weight: 600;
}
.stepper {
  gap: 10px;
  background: var(--bg);
  border-radius: 999px;
  padding: 3px 10px;
}
.step-btn {
  font-size: 15px;
  color: var(--ink2);
}
.step-num {
  font-size: 13px;
  font-weight: 700;
  min-width: 16px;
  text-align: center;
}
.coupon-row {
  padding: 12px 14px;
}

<!-- cart.wxml —— 购物车：勾选 + 数量步进 + 吸底结算 -->
<view class="pad">
  <view wx:for="{{items}}" wx:key="id" wx:for-index="i" class="card item-card">
    <view class="row" style="gap:10px">
      <text class="check" bindtap="toggleSelect" data-idx="{{i}}">{{item.selected ? '☑' : '☐'}}</text>
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="thumb" bindtap="openProduct" data-id="{{item.productId}}" />
      <view wx:else class="thumb center" style="background:var(--brand-soft);font-size:22px">☕</view>
      <view class="grow">
        <text class="item-name clamp2">{{item.productName}}</text>
        <view class="row" style="margin-top:6px;justify-content:space-between">
          <text class="price" style="font-size:14px">¥{{item.price}}</text>
          <view class="row stepper">
            <text class="step-btn" bindtap="dec" data-idx="{{i}}">−</text>
            <text class="step-num">{{item.quantity}}</text>
            <text class="step-btn" bindtap="inc" data-idx="{{i}}">＋</text>
          </view>
        </view>
      </view>
    </view>
    <view class="row" style="justify-content:flex-end;margin-top:8px">
      <text class="muted" style="font-size:11px" bindtap="remove" data-idx="{{i}}">删除</text>
    </view>
  </view>

  <view wx:if="{{!items.length && !loading}}" class="empty">购物车还是空的，去商城逛逛吧</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view wx:if="{{items.length}}" class="card row coupon-row">
    <text class="grow muted" style="font-size:12px">🎟 优惠券在提交订单页选择</text>
  </view>
  <view style="height:70px"></view>
</view>

<view class="action-bar row" style="gap:10px">
  <text class="ink2" style="font-size:12px" bindtap="toggleAll">{{allSelected ? '取消全选' : '全选'}}</text>
  <text class="grow" style="text-align:right;font-size:13px">
    合计 <text class="price" style="font-size:16px">¥{{total}}</text>
  </text>
  <view class="btn btn-brand" style="padding:9px 22px" bindtap="settle">结算({{selectedCount}})</view>
</view>

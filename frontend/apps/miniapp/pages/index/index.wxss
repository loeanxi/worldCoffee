/* index.wxss —— 发现 Tab */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: var(--bg);
}
.nav-row {
  gap: 10px;
  padding-left: 12px;
  height: 44px;
}
.logo {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--card);
  padding: 3px;
  flex-shrink: 0;
}
.search-pill {
  height: 32px;
  background: var(--card);
  padding: 0 12px;
  gap: 6px;
  font-size: 12px;
}
.search-act {
  font-size: 13px;
  font-weight: 600;
  flex-shrink: 0;
}
.pub-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 18px;
  flex-shrink: 0;
}
.chips-row {
  white-space: nowrap;
}
.main {
  padding: 0 10px 16px;
}
.wf {
  gap: 10px;
  align-items: flex-start;
  padding-top: 10px;
}
.wf-col {
  gap: 10px;
}
.feed-card {
  overflow: hidden;
}
.feed-img {
  width: 100%;
  display: block;
  border-radius: 16px 16px 0 0;
  background: var(--brand-soft);
}
.feed-body {
  padding: 8px 10px 10px;
}
.feed-title {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
}
.feed-meta {
  margin-top: 8px;
  gap: 5px;
}
.avatar {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  flex-shrink: 0;
}
.like {
  font-size: 11px;
  color: var(--ink3);
}
.like-on {
  color: var(--accent);
}
.ai-pill {
  position: fixed;
  right: 14px;
  bottom: 78px;
  z-index: 25;
  background: #fff;
  border-radius: 999px;
  padding: 8px 14px;
  gap: 6px;
  box-shadow: 0 6px 18px rgba(44, 38, 32, 0.14);
}

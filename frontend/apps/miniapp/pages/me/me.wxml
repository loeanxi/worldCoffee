<!-- me.wxml —— 我的 Tab：头部大卡 + 订单行 + 功能宫格 + 我的内容 -->
<view class="nav" style="padding-top:{{statusBarHeight}}px">
  <view class="row nav-pad-r me-nav-row">
    <text class="nav-title">我的</text>
    <view class="nav-icon-btn center" bindtap="goSettings">⚙</view>
  </view>
</view>

<view class="pad" style="padding-top:{{navHeight}}px">
  <!-- 头部大卡 -->
  <view class="card head-card">
    <view class="row" style="gap:12px">
      <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" class="head-avatar" />
      <view wx:else class="head-avatar center" style="background:var(--brand);color:#fff;font-size:20px;font-weight:700">{{initial}}</view>
      <view class="grow">
        <text class="head-name">{{nickname}}</text>
        <text class="head-bio muted">{{bio || '这个人很懒，什么都没写'}}</text>
      </view>
    </view>
    <view class="row stats-row">
      <view class="grow center stat"><text class="stat-num">{{stats.following}}</text><text class="stat-label muted">关注</text></view>
      <view class="grow center stat"><text class="stat-num">{{stats.followers}}</text><text class="stat-label muted">粉丝</text></view>
      <view class="grow center stat"><text class="stat-num">{{stats.likes}}</text><text class="stat-label muted">获赞</text></view>
      <view class="grow center stat"><text class="stat-num">{{stats.posts}}</text><text class="stat-label muted">笔记</text></view>
    </view>
  </view>

  <!-- 未登录引导 -->
  <view wx:if="{{!loggedIn}}" class="card login-card center" bindtap="goLogin">
    <text style="font-size:14px;font-weight:600;color:var(--brand-deep)">登录 / 注册，同步你的咖啡社区</text>
  </view>

  <!-- 我的订单 -->
  <view class="card block">
    <view class="row" style="justify-content:space-between">
      <text class="block-title">我的订单</text>
      <text class="muted" style="font-size:12px" bindtap="goOrders">全部 ›</text>
    </view>
    <view class="row order-row">
      <view class="grow center order-entry" bindtap="goOrders" data-status="0"><text class="order-ic">💳</text><text class="order-label ink2">待付款</text></view>
      <view class="grow center order-entry" bindtap="goOrders" data-status="1"><text class="order-ic">📦</text><text class="order-label ink2">待发货</text></view>
      <view class="grow center order-entry" bindtap="goOrders" data-status="2"><text class="order-ic">🚚</text><text class="order-label ink2">待收货</text></view>
      <view class="grow center order-entry" bindtap="goOrders" data-status="-1"><text class="order-ic">🎧</text><text class="order-label ink2">售后</text></view>
    </view>
  </view>

  <!-- 功能宫格 -->
  <view class="card grid">
    <view class="grid-item center" bindtap="goAddress">
      <view class="grid-ic center" style="background:var(--brand-soft);color:var(--brand-deep)">📍</view>
      <text class="grid-label ink2">地址管理</text>
    </view>
    <view class="grid-item center" bindtap="goCoupons">
      <view class="grid-ic center" style="background:var(--brand-soft);color:var(--brand-deep)">🎟</view>
      <text class="grid-label ink2">优惠券</text>
    </view>
    <view class="grid-item center" bindtap="goAI">
      <view class="grid-ic center" style="background:var(--brand-soft);color:var(--brand-deep)">🤖</view>
      <text class="grid-label ink2">AI 助手</text>
    </view>
    <button class="grid-item center contact-btn" open-type="contact">
      <view class="grid-ic center" style="background:var(--brand-soft);color:var(--brand-deep)">💬</view>
      <text class="grid-label ink2">客服</text>
    </button>
    <view class="grid-item center" bindtap="goLogin">
      <view class="grid-ic center" style="background:var(--accent-soft);color:var(--accent)">🔀</view>
      <text class="grid-label ink2">切换账号</text>
    </view>
  </view>

  <!-- 我的内容 -->
  <view class="card block">
    <view class="row" style="gap:8px">
      <text class="chip {{contentTab === 'posts' ? 'chip-on' : ''}}" style="font-size:11px;padding:5px 12px" bindtap="switchContent" data-key="posts">我的笔记</text>
      <text class="chip {{contentTab === 'favorites' ? 'chip-on' : ''}}" style="font-size:11px;padding:5px 12px" bindtap="switchContent" data-key="favorites">我的收藏</text>
    </view>
    <view wx:for="{{contentList}}" wx:key="id" class="row content-row" bindtap="openPost" data-id="{{item.id}}">
      <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="content-thumb" />
      <view wx:else class="content-thumb center" style="background:var(--brand-soft);font-size:16px">☕</view>
      <view class="grow" style="margin-left:10px">
        <text class="cut" style="font-size:13px">{{item.title}}</text>
        <text class="muted" style="display:block;font-size:11px;margin-top:3px">{{item.time}}</text>
      </view>
      <text class="muted">›</text>
    </view>
    <view wx:if="{{!contentList.length && !contentLoading}}" class="empty" style="padding:24px 0">
      {{contentTab === 'posts' ? '还没发过笔记' : '还没有收藏'}}
    </view>
  </view>

  <button wx:if="{{loggedIn}}" class="card logout-btn" bindtap="handleLogout">退出登录</button>
  <view style="height:20px"></view>
</view>

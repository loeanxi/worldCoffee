/* me.wxss —— 我的 Tab */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: var(--bg);
}
.me-nav-row {
  height: 44px;
  padding-left: 14px;
  justify-content: space-between;
}
.pad {
  padding: 8px 10px 14px;
}
.head-card {
  padding: 16px;
  margin-bottom: 10px;
  background: linear-gradient(135deg, var(--brand-soft), var(--card) 65%);
}
.head-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.head-name {
  display: block;
  font-size: 16px;
  font-weight: 700;
}
.head-bio {
  display: block;
  font-size: 11px;
  margin-top: 3px;
}
.stats-row {
  margin-top: 14px;
  text-align: center;
}
.stat {
  flex-direction: column;
}
.stat-num {
  font-size: 15px;
  font-weight: 700;
}
.stat-label {
  font-size: 11px;
}
.login-card {
  height: 56px;
  margin-bottom: 10px;
}
.block {
  padding: 12px 14px;
  margin-bottom: 10px;
}
.block-title {
  font-size: 14px;
  font-weight: 700;
}
.order-row {
  margin-top: 12px;
  text-align: center;
}
.order-entry {
  flex-direction: column;
  gap: 4px;
}
.order-ic {
  font-size: 20px;
}
.order-label {
  font-size: 11px;
}
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 14px 0;
  margin-bottom: 10px;
  text-align: center;
}
.grid-item {
  flex-direction: column;
  gap: 5px;
  background: transparent;
  border: none;
  line-height: 1.4;
}
.grid-item::after {
  border: none;
}
.contact-btn {
  font-size: inherit;
}
.grid-ic {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  font-size: 17px;
}
.grid-label {
  font-size: 11px;
}
.content-row {
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}
.content-row:last-child {
  border-bottom: none;
}
.content-thumb {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.logout-btn {
  width: 100%;
  height: 44px;
  margin-top: 10px;
  font-size: 14px;
  font-weight: 600;
  color: var(--danger);
  line-height: 44px;
}
.logout-btn::after {
  border: none;
}

/* me.wxss —— 我的 */
.me-page {
  padding-bottom: 60rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #3E2723;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 600;
}

.profile-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #3E2723;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #3E2723;
}

.row + .row {
  border-top: 1rpx solid #F5F0EB;
}

.actions {
  margin: 40rpx 24rpx;
}

.logged-out {
  flex-direction: column;
  padding: 100rpx 32rpx;
}

.brand-icon {
  width: 128rpx;
  height: 128rpx;
}

.empty-text {
  margin: 24rpx 0 40rpx;
  color: #8D6E63;
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
}

/* notify.wxss —— 通知列表 */
.bar {
  padding: 8px 14px;
}
.pad {
  padding: 0 12px 16px;
}
.item {
  padding: 12px;
  margin-bottom: 10px;
}
.unread {
  border-left: 3px solid var(--brand);
}
.ic {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 16px;
  flex-shrink: 0;
}
.line1 {
  display: block;
  font-size: 13px;
  line-height: 1.5;
}
.line2 {
  display: block;
  font-size: 11px;
  margin-top: 3px;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--danger);
  flex-shrink: 0;
}

<!-- confirm.wxml —— 确认订单：地址卡 + 商品清单 + 金额明细 + 支付 Sheet -->
<view class="pad">
  <view class="card addr-card" bindtap="editAddress">
    <text style="font-size:16px">📍</text>
    <view class="grow" style="margin-left:8px">
      <text class="addr-line1">{{addressName || '点击填写收货地址'}}</text>
      <text class="addr-line2">{{addressDetail || '提交订单前需要收货地址'}}</text>
    </view>
    <text class="muted">›</text>
  </view>

  <view class="card goods-card">
    <view wx:for="{{items}}" wx:key="id" class="goods-row {{index > 0 ? 'goods-row-gap' : ''}}">
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="goods-thumb" />
      <view wx:else class="goods-thumb center" style="background:var(--brand-soft);font-size:20px">☕</view>
      <view class="grow">
        <text class="goods-name clamp2">{{item.productName}}</text>
        <text class="muted" style="display:block;font-size:11px;margin-top:2px">× {{item.quantity}}</text>
      </view>
      <text class="price" style="font-size:13px">¥{{item.price}}</text>
    </view>
    <view wx:if="{{!items.length && !loading}}" class="empty" style="padding:24px 0">购物车为空</view>
  </view>

  <view class="card amount-card">
    <view class="row amount-row"><text>商品金额</text><text>¥{{goodsAmount}}</text></view>
    <view class="row amount-row gap"><text>运费</text><text>¥0.00</text></view>
    <view class="row amount-row gap"><text>备注</text><input class="remark-input" placeholder="选填，给商家留言" value="{{remark}}" bindinput="onRemark" /></view>
  </view>
  <view style="height:70px"></view>
</view>

<view class="action-bar row" style="gap:10px">
  <text class="grow" style="font-size:13px">实付 <text class="price" style="font-size:17px">¥{{goodsAmount}}</text></text>
  <view class="btn btn-brand" style="padding:9px 24px" bindtap="submit">提交订单</view>
</view>

<view wx:if="{{payOpen}}" class="sheet-mask">
  <view class="sheet" style="text-align:center">
    <view class="grab"></view>
    <text class="ink2" style="font-size:13px">微信支付</text>
    <text style="display:block;font-size:30px;font-weight:800;margin:10px 0 4px">¥{{goodsAmount}}</text>
    <text class="muted" style="font-size:12px">WorldCoffee 商城 · {{orderNo}}</text>
    <view class="center pay-mark">✓</view>
    <text class="muted" style="display:block;font-size:12px;margin-bottom:18px">{{paying ? '支付处理中…' : '模拟指纹 / 密码验证通过'}}</text>
    <view class="btn btn-brand" style="width:100%;height:44px" bindtap="finishPay">完成</view>
  </view>
</view>

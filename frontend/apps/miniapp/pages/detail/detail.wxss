/* detail.wxss —— 笔记详情 */
.head-swiper {
  width: 100%;
  height: 300px;
}
.head-img {
  width: 100%;
  height: 300px;
  background: var(--brand-soft);
}
.pad {
  padding: 14px;
}
.post-title {
  display: block;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.4;
}
.author-row {
  margin: 12px 0;
  gap: 8px;
}
.author-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--brand-soft);
  flex-shrink: 0;
}
.author-name {
  display: block;
  font-size: 13px;
  font-weight: 600;
}
.author-time {
  display: block;
  font-size: 11px;
}
.follow-btn {
  padding: 6px 16px;
  font-size: 12px;
}
.post-content {
  display: block;
  font-size: 14px;
  line-height: 1.8;
  color: var(--ink2);
}
.topic-row {
  gap: 6px;
  margin-top: 12px;
  flex-wrap: wrap;
}
.topic-chip {
  background: var(--brand-soft);
  color: var(--brand-deep);
}
.comment-card {
  margin-top: 14px;
  padding: 12px;
}
.comment-title {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink2);
}
.comment-item {
  margin-top: 10px;
}
.comment-line {
  font-size: 12px;
  color: var(--ink2);
  line-height: 1.7;
}
.comment-name {
  font-weight: 700;
  color: var(--ink);
}
.comment-input {
  height: 34px;
  background: var(--bg);
  color: var(--ink);
  font-size: 12px;
  padding: 0 14px;
}
.act {
  font-size: 13px;
  color: var(--ink2);
  flex-shrink: 0;
}
.like-on {
  color: var(--accent);
}
.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: 13px;
  color: var(--ink2);
}
.share-btn::after {
  border: none;
}

/* address-edit.wxss —— 地址表单 */
.pad {
  padding: 12px;
}
.form-card {
  padding: 4px 14px;
}
.field {
  height: 48px;
  gap: 12px;
}
.field.gap {
  border-top: 1px solid var(--line);
}
.label {
  width: 68px;
  font-size: 13px;
  color: var(--ink2);
  flex-shrink: 0;
}
.input {
  font-size: 13px;
  color: var(--ink);
}

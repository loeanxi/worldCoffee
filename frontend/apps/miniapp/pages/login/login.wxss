/* login.wxss —— 登录页 */
.login-page {
  min-height: 100vh;
  padding: 0 24px;
}
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72px 0 28px;
}
.brand-logo {
  width: 64px;
  height: 64px;
}
.brand-name {
  margin-top: 10px;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: 1px;
}
.brand-slogan {
  margin-top: 4px;
  font-size: 12px;
}
.form {
  padding: 20px 18px;
}
.wx-btn {
  width: 100%;
  height: 44px;
  font-size: 15px;
}
.split-line {
  margin: 16px 0 14px;
}
.input {
  background: var(--bg);
  border-radius: 12px;
  height: 44px;
  padding: 0 14px;
  margin-bottom: 12px;
  font-size: 14px;
}
.ph {
  color: var(--ink3);
}
.submit-btn {
  width: 100%;
  height: 44px;
  font-size: 15px;
}
.agree {
  display: block;
  text-align: center;
  font-size: 10px;
  margin-top: 14px;
}
